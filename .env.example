# Server-side only. Do not expose these through Vite client env variables.
# Option A: paste a short-lived app token from the eBay developer portal.
EBAY_ACCESS_TOKEN=

# Option B: let PopValue mint and cache app tokens with client credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope

EBAY_MARKETPLACE_ID=EBAY_US

# Production credentials:
EBAY_API_BASE_URL=https://api.ebay.com
# Sandbox credentials usually include "SBX". Use this instead for sandbox keys:
# EBAY_API_BASE_URL=https://api.sandbox.ebay.com

# Limited-release sold comps API. Enable only after eBay Marketplace Insights access is approved.
EBAY_ENABLE_SOLD_LOOKUP=false

# Local API server port
PORT=8787

# Client-side. Set this only when the frontend is hosted separately from the API.
# Example: https://your-api-host.vercel.app
VITE_API_BASE_URL=

# Client-side Supabase values for profile login and cloud-saved collections.
# Use the base project URL only: https://your-project.supabase.co
# Do not use the REST endpoint ending in /rest/v1.
# The anon key is intended for browser use; never expose the service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# PopValue also supports Vercel/Supabase integration public env names.
# If present, these are preferred over the VITE_SUPABASE_* values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
