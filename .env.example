# Server-side only. Do not expose these through Vite client env variables.
# Option A: paste a short-lived app token from the eBay developer portal.
EBAY_ACCESS_TOKEN=

# Option B: let PopValue mint and cache app tokens with client credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope

EBAY_MARKETPLACE_ID=EBAY_US
EBAY_API_BASE_URL=https://api.ebay.com

# Limited-release sold comps API. Enable only after eBay Marketplace Insights access is approved.
EBAY_ENABLE_SOLD_LOOKUP=false

# Local API server port
PORT=8787
